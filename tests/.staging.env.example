STAGING_INSTRUCTOR_PASS=
STAGING_STUDENT_USER=
STAGING_STUDENT_PASS=
STAGING_SUPERADMIN_USER=
STAGING_SUPERADMIN_PASS=

# UUIDs de staging:
STAGING_EST_OWN_ID=
STAGING_EST_OTHER_ID=
STAGING_STUDENT_OWN_ID=
STAGING_STUDENT_OTHER_ID=

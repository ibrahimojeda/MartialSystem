// Plantilla: cópiala a tests/.staging.env y rellena los valores reales de STAGING.
// Ese archivo es local (gitignored) y NO debe subirse ni pegarse en el chat.
STAGING_BASE_URL=http://localhost:8010

STAGING_OWNER_USER=
STAGING_OWNER_PASS=

